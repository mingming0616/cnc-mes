rules_version = '2';

// ============================================================
// CNC MES 安全規則（功能①登入＋人員、②主檔維護、③設備看板、④異動履歷、⑤修正紀錄、⑧平面圖、⑩借出狀態、
//                    ⑪匯入 v3.3 狀態）
// 發布方式：Firebase 主控台 → Firestore →「规则」→ 全部取代貼上 →「发布」
// 重點：沒登入、沒有人員資料、或已停用 → 什麼都不能讀寫
// 前提：Authentication 已關閉自行註冊，帳號只能在主控台建立
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共用判斷 ----------

    // 已登入，而且是「電子郵件／密碼」帳號
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // 從登入帳號取出工號：t001@cnc-mes.firebaseapp.com → T001
    function myEmpNo() {
      return request.auth.token.email.split('@')[0].upper();
    }

    function myProfilePath() {
      return /databases/$(database)/documents/users/$(myEmpNo());
    }

    // 在職：有人員資料，而且 active 是 true
    function isActive() {
      return signedIn()
        && exists(myProfilePath())
        && get(myProfilePath()).data.active == true;
    }

    // 管理者：在職，而且角色是 admin
    function isAdmin() {
      return isActive() && get(myProfilePath()).data.role == 'admin';
    }

    // 寫入時必須蓋上「伺服器時間」和「本人工號」
    function stamped() {
      return request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByEmpNo == myEmpNo();
    }

    // 文字欄位：長度在 min～max 之間
    function textOk(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // 排序數字：0～9999 的整數
    function sortOk(value) {
      return value is int && value >= 0 && value <= 9999;
    }

    // 設備編號、樓層代號：英文大寫、數字和「-」，2～12 碼，第一個字不能是「-」
    function codeOk(id) {
      return id.matches('^[A-Z0-9][A-Z0-9-]{1,11}$');
    }

    // ---------- 人員 users/{工號} ----------

    // 人員資料的欄位檢查
    function validUser(empNo) {
      let d = request.resource.data;
      return d.keys().hasOnly(['empNo', 'name', 'role', 'deptIds', 'active', 'updatedAt', 'updatedByEmpNo'])
        && d.keys().hasAll(['empNo', 'name', 'role', 'deptIds', 'active', 'updatedAt', 'updatedByEmpNo'])
        && empNo.matches('^[A-Z0-9]{2,10}$')
        && d.empNo == empNo
        && textOk(d.name, 1, 20)
        && d.role in ['admin', 'maintainer', 'viewer']
        && d.deptIds is list && d.deptIds.size() <= 20
        && d.active is bool
        && stamped();
    }

    // 管理者不能拿掉自己的管理者權限，也不能停用自己
    function notLockingSelf(empNo) {
      return empNo != myEmpNo()
        || (request.resource.data.role == 'admin' && request.resource.data.active == true);
    }

    match /users/{empNo} {
      // 本人可以讀自己的資料（停用了也能讀，畫面才能顯示「帳號未啟用」）；管理者可以讀全部
      allow read: if (signedIn() && myEmpNo() == empNo) || isAdmin();
      allow create: if isAdmin() && validUser(empNo);
      allow update: if isAdmin() && validUser(empNo) && notLockingSelf(empNo);
      // 任何人都不能刪除（離職改成停用，紀錄才追得回去）
      allow delete: if false;
    }

    // ---------- 單位 departments/{單位代號} ----------
    match /departments/{deptId} {
      allow read: if isActive();
      allow create, update: if isAdmin() && stamped();
      allow delete: if false;
    }

    // ---------- 系統設定 settings/{設定名稱}，例：shifts 班別 ----------
    match /settings/{settingId} {
      allow read: if isActive();
      allow create, update: if isAdmin() && stamped();
      allow delete: if false;
    }

    // ---------- 樓層 floors/{樓層代號} ----------

    function validFloor(floorId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['floorId', 'name', 'sortOrder', 'active', 'updatedAt', 'updatedByEmpNo'])
        && d.keys().hasAll(['floorId', 'name', 'sortOrder', 'active', 'updatedAt', 'updatedByEmpNo'])
        && codeOk(floorId)
        && d.floorId == floorId
        && textOk(d.name, 1, 20)
        && sortOk(d.sortOrder)
        && d.active is bool
        && stamped();
    }

    match /floors/{floorId} {
      allow read: if isActive();
      allow create, update: if isAdmin() && validFloor(floorId);
      // 不能刪除，不用了就關掉「使用中」
      allow delete: if false;
    }

    // ---------- 設備主檔 machines/{設備編號} ----------

    // 設備資料的欄位檢查：選的單位和樓層必須真的存在
    function validMachine(machineId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['machineId', 'deptId', 'floorId', 'category', 'brand', 'model',
                               'sortOrder', 'active', 'note', 'updatedAt', 'updatedByEmpNo'])
        && d.keys().hasAll(['machineId', 'deptId', 'floorId', 'category', 'brand', 'model',
                            'sortOrder', 'active', 'note', 'updatedAt', 'updatedByEmpNo'])
        && codeOk(machineId)
        && d.machineId == machineId
        && textOk(d.deptId, 1, 30)
        && existsAfter(/databases/$(database)/documents/departments/$(d.deptId))
        && textOk(d.floorId, 2, 12)
        && existsAfter(/databases/$(database)/documents/floors/$(d.floorId))
        && textOk(d.category, 1, 30)
        && textOk(d.brand, 1, 30)
        && textOk(d.model, 1, 30)
        && textOk(d.note, 0, 100)
        && sortOk(d.sortOrder)
        && d.active is bool
        && stamped();
    }

    match /machines/{machineId} {
      allow read: if isActive();
      allow create, update: if isAdmin() && validMachine(machineId);
      // 不能刪除，不用了就關掉「使用中」
      allow delete: if false;
    }

    // ---------- 平面圖 floorPlans/{樓層代號}（功能⑧） ----------

    // 平面圖的欄位檢查：樓層必須存在；整張圖存在 planData（一段文字，最多 80 萬字）
    function validFloorPlan(floorId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['floorId', 'source', 'width', 'height', 'machineCount', 'planData',
                               'active', 'updatedAt', 'updatedByEmpNo'])
        && d.keys().hasAll(['floorId', 'source', 'width', 'height', 'machineCount', 'planData',
                            'active', 'updatedAt', 'updatedByEmpNo'])
        && d.floorId == floorId
        && exists(/databases/$(database)/documents/floors/$(floorId))
        && textOk(d.source, 1, 100)
        && d.width is number && d.width > 0 && d.width <= 100000
        && d.height is number && d.height > 0 && d.height <= 100000
        && d.machineCount is int && d.machineCount >= 0 && d.machineCount <= 2000
        && textOk(d.planData, 2, 800000)
        && d.active is bool
        && stamped();
    }

    match /floorPlans/{floorId} {
      // 在職的人都能看（看板要畫）；只有管理者能匯入、停用
      allow read: if isActive();
      allow create, update: if isAdmin() && validFloorPlan(floorId);
      // 不能刪除：換圖就重新匯入蓋過去，不要了就把 active 關掉
      allow delete: if false;
    }

    // ---------- 機台狀態、事件紀錄（功能③、功能⑤修正紀錄） ----------

    function machinePath(machineId) {
      return /databases/$(database)/documents/machines/$(machineId);
    }

    function statusPath(machineId) {
      return /databases/$(database)/documents/machineStatus/$(machineId);
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/machineEvents/$(eventId);
    }

    // 9 種狀態代碼（功能⑩加「借出」lent）
    function statusCodeOk(code) {
      return code in ['running', 'setup', 'waiting', 'fault', 'qualityHold', 'maintenance', 'idle', 'offline', 'lent'];
    }

    // 可以切換這個單位機台狀態的人：管理者（全部單位）、維護員（負責單位）
    // me＝登入者的人員資料
    function canOperate(me, deptId) {
      return me.active == true
        && (me.role == 'admin' || (me.role == 'maintainer' && deptId in me.deptIds));
    }

    // 目前狀態是根據哪一筆「狀態變更」（功能⑤）
    //   lastEventId 指到狀態變更 → 就是那一筆；指到修正紀錄 → 看修正紀錄記的 baseEventId
    function baseOf(lastEventId) {
      let last = get(eventPath(lastEventId)).data;
      return last.eventType == 'correction' ? last.baseEventId : lastEventId;
    }

    // 「當班」（功能⑤）：台灣 08:00、20:00 換班＝世界標準時間 00:00、12:00，
    //   剛好每 12 小時一班：兩個時間落在同一個 12 小時區段＝同一班。
    //   班別時間如果改了，這裡和 history.js 的 shiftBlock() 都要跟著改。
    function sameShift(t) {
      return (t.toMillis() - (t.toMillis() % 43200000))
        == (request.time.toMillis() - (request.time.toMillis() % 43200000));
    }

    // 修正紀錄的某個欄位，範圍有沒有包含 base 這筆（功能⑤）
    function covers(c, key, base) {
      return key in c && base in c[key].eventIds;
    }

    // 修正範圍有沒有包含「目前狀態根據的那筆」（有的話，目前狀態也要一起改）
    function touchesBase(c, base) {
      return covers(c, 'reasonCode', base) || covers(c, 'partNo', base)
        || covers(c, 'opNo', base) || covers(c, 'note', base);
    }

    // 修正後，目前狀態這個欄位應該是什麼值：範圍包含 base 就用修正後的值，不然維持原本的
    function fieldAfter(c, key, base, old) {
      return covers(c, key, base) ? c[key].to : old;
    }

    // 目前狀態的欄位檢查（共同的部分）
    function validStatus(machineId) {
      let d = request.resource.data;
      let me = get(myProfilePath()).data;
      let m = get(machinePath(machineId)).data;
      let e = getAfter(eventPath(d.lastEventId)).data;
      return signedIn()
        && d.keys().hasOnly(['machineId', 'deptId', 'status', 'reasonCode', 'note', 'partNo', 'opNo',
                             'statusSince', 'lastEventId', 'updatedAt', 'updatedByEmpNo', 'updatedByName'])
        && d.keys().hasAll(['machineId', 'deptId', 'status', 'reasonCode', 'note', 'partNo', 'opNo',
                            'statusSince', 'lastEventId', 'updatedAt', 'updatedByEmpNo', 'updatedByName'])
        && d.machineId == machineId
        && m.active == true
        && d.deptId == m.deptId                      // 單位以設備主檔為準
        && canOperate(me, d.deptId)
        && statusCodeOk(d.status)
        && textOk(d.reasonCode, 0, 30)
        && textOk(d.note, 0, 100)
        && textOk(d.partNo, 0, 40)
        && textOk(d.opNo, 0, 20)
        && d.statusSince is timestamp
        && d.updatedAt == request.time
        && d.updatedByEmpNo == myEmpNo()
        && d.updatedByName == me.name
        // 一定要同時新增一筆對應的事件紀錄：切換狀態（功能③）或修正紀錄（功能⑤）
        && !exists(eventPath(d.lastEventId))         // 寫入前不存在＝這次新建的
        && e.machineId == machineId
        && e.createdAt == request.time
        && ((e.eventType == 'statusChange' && statusByChange(d, e))
            || (e.eventType == 'correction' && statusByCorrection(d, e))
            || (e.eventType == 'import' && statusByImport(d, e, me)));
    }

    // 匯入 v3.3 狀態（功能⑪）：只有管理者；內容要跟匯入事件一樣，
    //   開始時間沿用 v3.3（可以是過去的時間，記在事件的 importedSince）
    function statusByImport(d, e, me) {
      return me.role == 'admin'
        && e.toStatus == d.status
        && e.reasonCode == d.reasonCode
        && e.partNo == d.partNo
        && e.opNo == d.opNo
        && e.note == d.note
        && d.statusSince == e.importedSince;
    }

    // 切換狀態（功能③）
    function statusByChange(d, e) {
      return e.toStatus == d.status
        && e.reasonCode == d.reasonCode
        // 狀態或原因有變 → 從現在重新計時；只改備註、料號、製程 → 沿用原本的開始時間
        && (d.statusSince == request.time
            || (resource != null
                && d.status == resource.data.status
                && d.reasonCode == resource.data.reasonCode
                && d.statusSince == resource.data.statusSince));
    }

    // 修正紀錄連帶改到目前狀態（功能⑤）：狀態和開始時間不變；
    //   範圍包含「目前狀態根據的那筆」的欄位換成修正後的值，其他欄位維持原本的
    function statusByCorrection(d, e) {
      return resource != null && correctedStatusOk(d, e.changes, e.baseEventId, baseOf(resource.data.lastEventId));
    }

    function correctedStatusOk(d, c, fixBase, base) {
      return fixBase == base
        && touchesBase(c, base)
        && d.status == resource.data.status
        && d.statusSince == resource.data.statusSince
        && d.reasonCode == fieldAfter(c, 'reasonCode', base, resource.data.reasonCode)
        && d.partNo == fieldAfter(c, 'partNo', base, resource.data.partNo)
        && d.opNo == fieldAfter(c, 'opNo', base, resource.data.opNo)
        && d.note == fieldAfter(c, 'note', base, resource.data.note);
    }

    match /machineStatus/{machineId} {
      allow read: if isActive();
      allow create, update: if validStatus(machineId);
      allow delete: if false;
    }

    // 事件紀錄：切換狀態（功能③）的欄位檢查
    function validEvent(eventId) {
      let d = request.resource.data;
      let me = get(myProfilePath()).data;
      let m = get(machinePath(d.machineId)).data;
      let before = statusPath(d.machineId);
      return signedIn()
        && d.keys().hasOnly(['eventType', 'machineId', 'deptId', 'fromStatus', 'fromStatusSince', 'toStatus',
                             'reasonCode', 'note', 'partNo', 'opNo', 'prodDate', 'shiftId',
                             'createdAt', 'createdByEmpNo', 'createdByName'])
        && d.keys().hasAll(['eventType', 'machineId', 'deptId', 'fromStatus', 'fromStatusSince', 'toStatus',
                            'reasonCode', 'note', 'partNo', 'opNo', 'prodDate', 'shiftId',
                            'createdAt', 'createdByEmpNo', 'createdByName'])
        && d.eventType == 'statusChange'
        && m.active == true
        && d.deptId == m.deptId
        && canOperate(me, d.deptId)
        // 「從什麼狀態」要跟資料庫裡原本的一樣（第一次設定時是 null）
        && ((!exists(before) && d.fromStatus == null && d.fromStatusSince == null)
            || (exists(before)
                && d.fromStatus == get(before).data.status
                && d.fromStatusSince == get(before).data.statusSince))
        && statusCodeOk(d.toStatus)
        && textOk(d.reasonCode, 0, 30)
        && textOk(d.note, 0, 100)
        && textOk(d.partNo, 0, 40)
        && textOk(d.opNo, 0, 20)
        && d.prodDate is string && d.prodDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.shiftId in ['D', 'N']
        && d.createdAt == request.time
        && d.createdByEmpNo == myEmpNo()
        && d.createdByName == me.name
        // 一定要同時更新這台機的目前狀態，而且指向這筆事件
        && getAfter(before).data.lastEventId == eventId;
    }

    // 修正紀錄（功能⑤）的欄位檢查
    //   原本那筆不改；新增一筆 eventType: 'correction'，記下從哪一筆開始、改了什麼、連帶哪些紀錄
    function validCorrection(eventId) {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly(['eventType', 'machineId', 'deptId', 'correctsEventId', 'correctsEventAt',
                             'baseEventId', 'changes', 'eventIds', 'correctionReason',
                             'prodDate', 'shiftId', 'createdAt', 'createdByEmpNo', 'createdByName'])
        && d.keys().hasAll(['eventType', 'machineId', 'deptId', 'correctsEventId', 'correctsEventAt',
                            'baseEventId', 'changes', 'eventIds', 'correctionReason',
                            'prodDate', 'shiftId', 'createdAt', 'createdByEmpNo', 'createdByName'])
        && d.eventType == 'correction'
        && d.machineId is string
        && d.correctsEventId is string
        && d.baseEventId is string
        && changesOk(d.changes, d.correctsEventId, d.eventIds)
        && textOk(d.correctionReason, 2, 100)
        && d.prodDate is string && d.prodDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.shiftId in ['D', 'N']
        && d.createdAt == request.time
        && d.createdByEmpNo == myEmpNo()
        && correctionTargetOk(d, eventId);
    }

    // 修正紀錄要對得上：權限、要修正的那筆、當班、目前狀態（功能⑤）
    function correctionTargetOk(d, eventId) {
      let me = get(myProfilePath()).data;
      let m = get(machinePath(d.machineId)).data;
      let t = get(eventPath(d.correctsEventId)).data;
      let base = baseOf(get(statusPath(d.machineId)).data.lastEventId);
      return d.createdByName == me.name
        && m.active == true
        && d.deptId == m.deptId                      // 單位以設備主檔為準
        && canOperate(me, d.deptId)
        // 要修正的是同一台機的「狀態變更」紀錄
        && t.eventType == 'statusChange'
        && t.machineId == d.machineId
        && d.correctsEventAt == t.createdAt
        // 管理者不限時間；維護員只能改當班的紀錄
        && (me.role == 'admin' || sameShift(t.createdAt))
        // 修正當下，目前狀態根據的那筆要對（有人剛切換狀態就存不進去）
        && d.baseEventId == base
        // 修正範圍包含目前狀態 → 一定要同時更新目前狀態，而且指向這筆修正
        && (!touchesBase(d.changes, base)
            || getAfter(statusPath(d.machineId)).data.lastEventId == eventId);
    }

    // 改了哪些欄位：只能是原因、料號、製程、備註；全部受影響的紀錄最多 50 筆，第一筆是要修正的那筆
    function changesOk(c, startId, allIds) {
      return c is map
        && c.size() >= 1
        && c.keys().hasOnly(['reasonCode', 'partNo', 'opNo', 'note'])
        && allIds is list
        && allIds.size() >= 1
        && allIds.size() <= 50
        && allIds[0] == startId
        && changeOk(c, 'reasonCode', 30, startId, allIds)
        && changeOk(c, 'partNo', 40, startId, allIds)
        && changeOk(c, 'opNo', 20, startId, allIds)
        && changeOk(c, 'note', 100, startId, allIds);
    }

    // 一個欄位的修正：改前、改後（要不一樣）、連帶哪些紀錄（第一筆是要修正的那筆）
    function changeOk(c, key, maxLen, startId, allIds) {
      return !(key in c)
        || (c[key] is map
            && c[key].keys().hasOnly(['from', 'to', 'eventIds'])
            && c[key].keys().hasAll(['from', 'to', 'eventIds'])
            && textOk(c[key].from, 0, maxLen)
            && textOk(c[key].to, 0, maxLen)
            && c[key].from != c[key].to
            && c[key].eventIds is list
            && c[key].eventIds.size() >= 1
            && c[key].eventIds.size() <= 50
            && c[key].eventIds[0] == startId
            && allIds.hasAll(c[key].eventIds));
    }

    // 匯入 v3.3 狀態（功能⑪）的欄位檢查
    //   一次性把 v3.3 看板的目前狀態搬進來：只有管理者能寫；
    //   跟切換狀態一樣要同時更新目前狀態，「從什麼狀態」也要跟資料庫原本的一樣；
    //   開始時間 importedSince 沿用 v3.3（不能晚於現在）；這筆不能用修正紀錄改
    function validImport(eventId) {
      let d = request.resource.data;
      let me = get(myProfilePath()).data;
      let m = get(machinePath(d.machineId)).data;
      let before = statusPath(d.machineId);
      return signedIn()
        && d.keys().hasOnly(['eventType', 'source', 'sourceStatus', 'machineId', 'deptId',
                             'fromStatus', 'fromStatusSince', 'toStatus', 'reasonCode', 'note', 'partNo', 'opNo',
                             'importedSince', 'prodDate', 'shiftId', 'createdAt', 'createdByEmpNo', 'createdByName'])
        && d.keys().hasAll(['eventType', 'source', 'sourceStatus', 'machineId', 'deptId',
                            'fromStatus', 'fromStatusSince', 'toStatus', 'reasonCode', 'note', 'partNo', 'opNo',
                            'importedSince', 'prodDate', 'shiftId', 'createdAt', 'createdByEmpNo', 'createdByName'])
        && d.eventType == 'import'
        && d.source == 'v3.3'
        && textOk(d.sourceStatus, 1, 20)
        && me.active == true
        && me.role == 'admin'
        && m.active == true
        && d.deptId == m.deptId
        && ((!exists(before) && d.fromStatus == null && d.fromStatusSince == null)
            || (exists(before)
                && d.fromStatus == get(before).data.status
                && d.fromStatusSince == get(before).data.statusSince))
        && statusCodeOk(d.toStatus)
        && textOk(d.reasonCode, 0, 30)
        && textOk(d.note, 0, 100)
        && textOk(d.partNo, 0, 40)
        && textOk(d.opNo, 0, 20)
        && d.importedSince is timestamp
        && d.importedSince <= request.time
        && d.prodDate is string && d.prodDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.shiftId in ['D', 'N']
        && d.createdAt == request.time
        && d.createdByEmpNo == myEmpNo()
        && d.createdByName == me.name
        // 一定要同時更新這台機的目前狀態：指向這筆事件，開始時間跟這筆一樣
        && getAfter(before).data.lastEventId == eventId
        && getAfter(before).data.statusSince == d.importedSince;
    }

    match /machineEvents/{eventId} {
      allow read: if isActive();
      // 依 eventType 分開檢查：切換狀態（功能③）、修正紀錄（功能⑤）、匯入 v3.3 狀態（功能⑪）
      allow create: if (request.resource.data.eventType == 'statusChange' && validEvent(eventId))
                    || (request.resource.data.eventType == 'correction' && validCorrection(eventId))
                    || (request.resource.data.eventType == 'import' && validImport(eventId));
      // 事件紀錄只能新增，任何人都不能改、不能刪
      allow update, delete: if false;
    }

    // 其他集合（工單、報工…）還沒做到，
    // 這裡沒寫就等於全部鎖住，做到該功能時再開放。
  }
}
